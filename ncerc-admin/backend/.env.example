# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of THIS backend (used for OAuth callback URLs)
BACKEND_URL=http://localhost:5000

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/ncerc_admin

# ---------- CORS (only these origins may call the API) ----------
ADMIN_FRONTEND_URL=http://localhost:3001
NCERC_WEBSITE_URL=http://localhost:3000
# optional, comma separated (e.g. a staging site or www. variant)
EXTRA_ALLOWED_ORIGINS=

# ---------- Auth ----------
# generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# lax works when admin site and API share the same site; use "none" if they are on different domains (requires HTTPS)
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ---------- First super admin (used by: npm run seed:super-admin) ----------
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@ncerc.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@12345

# ---------- Google login (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Facebook login (optional) ----------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Cloudinary image uploads (optional until you upload images) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ncerc/events

# ---------- Mail for forgot-password (optional in dev: the link is printed in the console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NCERC Admin <no-reply@ncerc.ac.in>"
